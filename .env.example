# Copy to .env and fill in. Without any API key (Gemini, Anthropic or OpenAI) only the local model is used.
GEMINI_API_KEY=
PRIMARY_MODEL=gemini/gemini-3.8-flash
# Second Gemini model (another family and quota) for when the primary is overloaded; leave empty to disable
SECONDARY_MODEL=gemini/gemini-3.1-flash-lite
FALLBACK_MODEL=ollama_chat/qwen2.5:7b

# Claude (Anthropic) and Codex/GPT (OpenAI): used only when their key is set
ANTHROPIC_API_KEY=
CLAUDE_MODEL=anthropic/claude-sonnet-5-5
OPENAI_API_KEY=
# Any OpenAI model your account has, e.g. a Codex model
OPENAI_MODEL=openai/gpt-5
# Fallback order (gemini, gemini_secondary, claude, openai, ollama); providers without credentials are skipped
LLM_CHAIN=gemini,gemini_secondary,claude,openai,ollama
# A single embeddings model so all vectors live in the same space
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_DIM=768
# Minimum similarity to use a historical task when estimating
HISTORY_MIN_SIMILARITY=0.6

# Values for running outside Docker (docker-compose overrides them)
DATABASE_URL=postgresql+asyncpg://holly:holly@localhost:5434/holly
REDIS_URL=redis://localhost:6380/0
OLLAMA_API_BASE=http://localhost:11600
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4327

# Signs session tokens: use a long random value
SECRET_KEY=dev-secret-change-me

# Name clients see (chat, agents, proposal)
COMPANY_NAME=Holly
